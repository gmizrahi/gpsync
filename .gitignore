# Build output. Binaries are never committed -- bin/ is local development
# output, dist/ is release artefacts.
/bin/
/dist/
*.exe
*.test
*.out
# The documented dev build (`go build -o gpsync ./cmd/gpsync`) drops a
# binary right here, where nothing above matches it -- one `git add -A`
# from being committed to a public repo.
/gpsync
/gpsync-tray

# Local AI working notes — never published
.ai/
CLAUDE.md

# Never commit credentials or local state, even if GPSYNC_STATE_DIR is
# misconfigured to point at the working tree.
.gpsync/
*.sqlite
*.sqlite-wal
*.sqlite-shm
client_secret*.json
token.json
